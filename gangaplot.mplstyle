# gangaplot, at the size the paper uses: a 2x2 grid of ~1 in panels drawn at
# \columnwidth (246 pt) and included unscaled.  A reconstruction of the lost
# original style; strokes are the original's scaled to the panel, floored so
# they stay black rather than grey, and text is absolute (6 pt ticks, 10 pt
# labels, the body text size).
#
# Every value here is the one the figures of "When energy isn't enough" are
# drawn with, so plt.style.use("gangaplot") alone reproduces them.  The layout
# (panel grid, horizontal y labels, panel letters, shared legend) is not an
# rcParam: see STYLE.md.

text.usetex:          True
font.family:          serif
font.serif:           Computer Modern Roman
text.latex.preamble:  \usepackage{amsmath}\usepackage{amssymb}\usepackage{braket}
font.size:            10
axes.labelsize:       10
axes.titlesize:       7
xtick.labelsize:      6
ytick.labelsize:      6
legend.fontsize:      8

# Series: good (blue, square) then poor (purple, diamond), gnuplot2's dark blue
# and light purple; then gnuplot2's pink and gold for a third and fourth.
axes.prop_cycle: cycler('color', ['0000a8', 'c92ad5', 'ff5ca3', 'ffc23d']) + cycler('marker', ['s', 'D', 'o', 'v'])
# A bare line is the exact/theory curve: black dashed at 1.25x this width.
lines.linewidth:       0.55
lines.linestyle:       --
# Run markers are hollow, at this size and edge width.
lines.markersize:      2.4
lines.markeredgewidth: 0.6787
markers.fillstyle:     none
axes.linewidth:        0.7
axes.grid:             False
axes.axisbelow:        True
axes.formatter.use_mathtext: True

xtick.direction:      in
xtick.top:            True
xtick.bottom:         True
xtick.minor.visible:  True
xtick.major.size:     2.3
xtick.minor.size:     1.25
xtick.major.width:    0.45
xtick.minor.width:    0.3
xtick.major.pad:      1.6
ytick.direction:      in
ytick.left:           True
ytick.right:          True
ytick.minor.visible:  True
ytick.major.size:     2.3
ytick.minor.size:     1.25
ytick.major.width:    0.45
ytick.minor.width:    0.3
ytick.major.pad:      1.6

# One frameless legend above the grid.
legend.frameon:        False
legend.numpoints:      1
legend.borderaxespad:  0.0
legend.handlelength:   1.4
legend.handletextpad:  0.4
legend.columnspacing:  1.1
legend.labelspacing:   0.5

figure.facecolor:     white
figure.dpi:           600
savefig.dpi:          600
savefig.facecolor:    white
