figure.facecolor: white
figure.edgecolor: white
figure.dpi: 300             # Higher DPI for sharper output
savefig.dpi: 300
savefig.format: png         # Or 'pdf', 'eps' for vector graphics
savefig.bbox: tight         # Prevent cutting off elements

# --- Axes Settings ---
axes.facecolor: white
axes.edgecolor: black
axes.linewidth: 1.0         # Axis line thickness
axes.grid: False            # No grid lines
axes.axisbelow: True        # Grid lines appear below plot elements
axes.labelcolor: black
axes.labelsize: 14          # Size of x and y axis labels
axes.titlesize: 14          # Size of plot title

# --- Tick Settings ---
xtick.direction: out        # Ticks point outwards
ytick.direction: out        # Ticks point outwards
xtick.major.size: 5.0       # Length of major x-ticks
ytick.major.size: 5.0       # Length of major y-ticks
xtick.minor.size: 3.0       # Length of minor x-ticks
ytick.minor.size: 3.0       # Length of minor y-ticks
xtick.major.width: 1.0      # Thickness of major x-ticks (slightly thicker than axis?)
ytick.major.width: 1.0      # Thickness of major y-ticks
xtick.minor.width: 0.8      # Thickness of minor x-ticks (slightly thinner)
ytick.minor.width: 0.8      # Thickness of minor y-ticks
xtick.color: black
ytick.color: black
xtick.labelsize: 12         # Size of x-tick labels
ytick.labelsize: 12         # Size of y-tick labels
xtick.top: True             # Show ticks on the top x-axis
ytick.right: True           # Show ticks on the right y-axis

# --- Line Settings ---
lines.linewidth: 1.5        # Default line width (for curve fits, etc.)
lines.markersize: 6.0       # Default marker size

# --- Text Settings ---
# Likely uses LaTeX for font rendering based on the look
text.usetex: True
# Font family to use with LaTeX. 'serif' often maps to Times New Roman or Computer Modern.
font.family: serif
# You might need to specify a specific font if 'serif' isn't what you want
# font.serif: Times New Roman # Requires appropriate LaTeX package
font.size: 12               # Default font size

# --- Legend Settings ---
legend.frameon: True        # Draw a box around the legend
legend.edgecolor: black     # Color of the legend box edge
legend.fancybox: False      # Don't use rounded corners
legend.shadow: False        # No shadow
legend.loc: upper left      # Position matching the example
legend.fontsize: 12         # Font size in the legend

# --- Patch Settings (used for legend box, etc.) ---
patch.edgecolor: black
patch.linewidth: 1.0

# --- Grid Settings (disabled, but defining them anyway) ---
grid.color: black
grid.linestyle: -
grid.linewidth: 0.8

# SCATTER PLOT
scatter.marker : .


